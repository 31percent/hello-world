PORT=3001
NODE_ENV=development

# Twitter OAuth (înlocuiește cu valorile tale de la developer.twitter.com)
TWITTER_CONSUMER_KEY=your_twitter_consumer_key_here
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret_here

# Session Secret (înlocuiește cu un string aleatoriu sigur)
SESSION_SECRET=poker-live-session-secret-change-this-in-production

# Client URL
CLIENT_URL=http://localhost:3000